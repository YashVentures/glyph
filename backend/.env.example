# Glyph FastAPI Backend Configuration
MONGODB_URL=mongodb://localhost:27017/glyph_db
DB_NAME=glyph_db
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Fixed Default Identity (No Auth Required)
DEFAULT_WORKSPACE_ID=default-workspace
DEFAULT_USER_ID=default-user

# Step 7: AI Provider Configuration (OpenAI-compatible)
# Works with OpenAI, Groq, OpenRouter, Gemini, Ollama, etc.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=60
AI_MAX_PROMPT_LENGTH=2000
